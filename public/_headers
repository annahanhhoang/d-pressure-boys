# Cache-Control headers for Netlify / Cloudflare Pages / Vercel
# Hashed JS/CSS/image assets — content-hash in filename means safe to cache forever
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# HTML: always revalidate so new deploys are seen immediately
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# Fonts (if ever self-hosted into /public)
/*.woff2
  Cache-Control: public, max-age=31536000, immutable
/*.woff
  Cache-Control: public, max-age=31536000, immutable
